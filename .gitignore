# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Note: outputs/ here holds ONLY the small audit/calibration/manifest artefacts
# referenced by roadmap.md (the ~7 GB of raw per-seed run data is NOT shipped).

# LaTeX build artifacts (the typeset manuscript is not vendored; generators may
# still emit a local .tex/.aux when run, which should not be committed)
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.tex

# ...except the figure sources. Every manuscript figure is native TikZ/pgfplots
# reading from tikz_data/*.dat, so these ARE the figures, not the manuscript.
# Without them the package regenerates the superseded matplotlib versions.
!docs/paper_combined/*_tikz.tex
!docs/paper_combined/_pgfstyle.tex

# OS / editor
.DS_Store
.idea/
.vscode/

# Regenerated per-section figures (canonical set is in docs/paper_combined/figures)
docs/results1_digital_twin_overleaf/figures/
docs/results2_control_overleaf/figures/
docs/results3_transferability_overleaf/figures/

# Generator intermediates (full per-section bodies; not needed in the repo)
docs/results1_digital_twin_overleaf/section_body.tex
docs/results2_control_overleaf/section_body.tex
docs/results3_transferability_overleaf/section_body.tex
